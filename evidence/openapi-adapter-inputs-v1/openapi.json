                            "nullable": true
                          },
                          "audit": {
                            "type": "boolean",
                            "nullable": true
                          }
                        }
                      }
                    },
                    "default": {
                      "owner": "new",
                      "flags": {}
                    }
                  }
                }
              }
            }
          }
        },
