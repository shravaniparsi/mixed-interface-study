                    "nullable": true,
                    "default": "new"
                  },
                  "enabled": {
                    "type": "boolean",
                    "nullable": true,
                    "default": true
                  },
                  "quota": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0,
                    "maximum": 100,
                    "default": 7
                  },
                  "tags": {
                    "type": "array",
                    "nullable": true,
                    "items": {
                      "type": "string"
                    },
                    "default": [
                      "default"
                    ]
                  },
                  "metadata": {
                    "type": "object",
                    "nullable": true,
                    "additionalProperties": false,
                    "properties": {
                      "owner": {
                        "type": "string",
                        "nullable": true
                      },
                      "flags": {
                        "type": "object",
                        "nullable": true,
                        "additionalProperties": false,
                        "properties": {
