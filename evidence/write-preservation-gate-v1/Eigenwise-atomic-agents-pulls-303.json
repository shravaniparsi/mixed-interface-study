  "title": "fix: preserve explicit nulls in MCP tool arguments",
  "user": {
    "login": "liangzhechen655",
    "id": 186018027,
    "node_id": "U_kgDOCxZo6w",
    "avatar_url": "https://avatars.githubusercontent.com/u/186018027?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/liangzhechen655",
    "html_url": "https://github.com/liangzhechen655",
    "followers_url": "https://api.github.com/users/liangzhechen655/followers",
    "following_url": "https://api.github.com/users/liangzhechen655/following{/other_user}",
    "gists_url": "https://api.github.com/users/liangzhechen655/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/liangzhechen655/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/liangzhechen655/subscriptions",
    "organizations_url": "https://api.github.com/users/liangzhechen655/orgs",
    "repos_url": "https://api.github.com/users/liangzhechen655/repos",
    "events_url": "https://api.github.com/users/liangzhechen655/events{/privacy}",
    "received_events_url": "https://api.github.com/users/liangzhechen655/received_events",
